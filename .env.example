# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# Meta System User access token (200+ chars, starts with EAA)
META_ACCESS_TOKEN=your_token_here

# Studio's Meta ad account ID (format: act_##########)
# Find at: https://adsmanager.facebook.com/ → top-left dropdown
META_AD_ACCOUNT_ID=act_0000000000

# Marketing API version to pin against
META_API_VERSION=v25.0

# Optional: business portfolio ID (from Business Settings → Business Info)
META_BUSINESS_ID=

# Meta Pixel ID for saged.club landing (public — visible in JS once consent given)
META_PIXEL_ID=
