<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>club.saged.kids-monitor</string>

    <!-- Runtime lives in ~/Library/Application Support/saged-kids-monitor/ because
         macOS TCC blocks launchd-spawned python3 from reading inside ~/Documents/.
         See ~/Documents/saged.club/docs/skills/kids-monitor-runtime.md (if created)
         and the 2026-06-08 cron→launchd migration. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/diana/Library/Application Support/saged-kids-monitor/scripts/check-kids-status.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/diana/Library/Application Support/saged-kids-monitor</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/diana/Library/Application Support/saged-kids-monitor/reports/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/diana/Library/Application Support/saged-kids-monitor/reports/launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
